# The simulation stack runs inside Linux/WSL: keep LF endings even on Windows checkouts
# (core.autocrlf=true would otherwise turn these into CRLF and break bash and ROS 2).
*.sh     text eol=lf
*.py     text eol=lf
*.sdf    text eol=lf
*.xml    text eol=lf
*.rviz   text eol=lf
*.cfg    text eol=lf
*.yaml   text eol=lf
*.txt    text eol=lf
*.ps1    text eol=crlf
*.png    binary
