<?xml version="1.0" ?>
<!--
  Indoor exploration arena for the GPS-denied 3-drone swarm (Gazebo Harmonic).

  24 m x 20 m enclosed room (x: -12..12, y: -9..11) with 3 m tall walls, pillars and
  partitions so that a forward-facing depth camera at 1.5 m altitude sees every obstacle.
  Drones take off from the three coloured pads along y = -6.

  This file is the single source of truth for the environment: coordination/swarm_sim_bridge.py
  parses the static box models below to draw the same obstacles in RViz2.
-->
<sdf version="1.9">
  <world name="simple_world">
    <physics name="default_physics" type="dart">
      <!-- 2 ms steps (500 Hz) keep three rotor-dynamics drones in real time on a laptop -->
      <max_step_size>0.002</max_step_size>
      <real_time_factor>1</real_time_factor>
    </physics>

    <scene>
      <ambient>0.5 0.5 0.5 1.0</ambient>
      <background>0.8 0.8 0.8 1.0</background>
      <shadows>true</shadows>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0.0 -16.0 12.0 0.0 0.65 1.5708</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
    </plugin>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands">
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster">
    </plugin>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu">
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <intensity>1</intensity>
      <direction>0.5 0.1 -0.9</direction>
      <specular>0.5 0.5 0.5</specular>
      <diffuse>0.8 0.8 0.8</diffuse>
      <pose>0 0 10 0 0 0</pose>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ===================== Arena walls and obstacles ===================== -->
    <model name="wall_south">
      <static>true</static>
      <pose>0.0 -9.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>24.2 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>24.2 0.2 3.0</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0.0 11.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>24.2 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>24.2 0.2 3.0</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-12.0 1.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 20.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 20.0 3.0</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>12.0 1.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>0.2 20.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 20.0 3.0</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="partition_west">
      <static>true</static>
      <pose>-10.0 -1.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.0 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.0 0.2 3.0</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="partition_east">
      <static>true</static>
      <pose>10.0 -1.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>4.0 0.2 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>4.0 0.2 3.0</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.7 0.7 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_1">
      <static>true</static>
      <pose>3.0 3.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 3.0</size></box></geometry>
          <material><ambient>0.5 0.2 0.2 1</ambient><diffuse>0.7 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_2">
      <static>true</static>
      <pose>-3.0 3.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 3.0</size></box></geometry>
          <material><ambient>0.5 0.2 0.2 1</ambient><diffuse>0.7 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_3">
      <static>true</static>
      <pose>3.0 -3.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 3.0</size></box></geometry>
          <material><ambient>0.5 0.2 0.2 1</ambient><diffuse>0.7 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="obstacle_4">
      <static>true</static>
      <pose>-3.0 -3.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.0 1.0 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.0 1.0 3.0</size></box></geometry>
          <material><ambient>0.5 0.2 0.2 1</ambient><diffuse>0.7 0.3 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_1">
      <static>true</static>
      <pose>-6.0 2.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.6 1.6 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.6 1.6 3.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_2">
      <static>true</static>
      <pose>6.0 2.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.6 1.6 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.6 1.6 3.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_3">
      <static>true</static>
      <pose>-6.0 8.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.6 1.6 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.6 1.6 3.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_4">
      <static>true</static>
      <pose>6.0 8.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>1.6 1.6 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>1.6 1.6 3.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="central_block">
      <static>true</static>
      <pose>0.0 6.0 1.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.4 1.2 3.0</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.4 1.2 3.0</size></box></geometry>
          <material><ambient>0.3 0.3 0.35 1</ambient><diffuse>0.45 0.45 0.5 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ===================== Take-off / landing pads ===================== -->
    <model name="pad_drone_1">
      <static>true</static>
      <pose>-4.0 -6.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.6</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.0 0.6 0.8 1</ambient><diffuse>0.0 0.7 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pad_drone_2">
      <static>true</static>
      <pose>0.0 -6.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.6</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.9 0.5 0.0 1</ambient><diffuse>1.0 0.6 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pad_drone_3">
      <static>true</static>
      <pose>4.0 -6.0 0.005 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><cylinder><radius>0.6</radius><length>0.01</length></cylinder></geometry>
          <material><ambient>0.6 0.1 0.7 1</ambient><diffuse>0.7 0.2 0.8 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
