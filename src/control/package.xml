<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>control</name>
  <version>0.0.1</version>
  <description>
    M2 minimal ROS 2 package for PX4 SITL communication via uXRCE-DDS.
    
    This package provides a basic control node that:
    - Subscribes to PX4 vehicle status topics
    - Publishes telemetry for monitoring
    - Can send commands (arm/disarm) to PX4 via ROS 2
  </description>
  <maintainer email="gps-denied@example.com">GPS-Denied Project</maintainer>
  <license>MIT</license>

  <!-- ROS 2 build dependencies -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Runtime dependencies -->
  <depend>rclcpp</depend>
  <depend>px4_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>sensor_msgs</depend>

  <!-- Testing -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
