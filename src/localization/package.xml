<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>localization</name>
  <version>0.0.1</version>
  <description>Ground-truth pose publisher for M3-M10; VSLAM/VIO integration for M11+</description>
  <maintainer email="gps.denied@project.local">GPS-Denied Project</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- Core dependencies -->
  <depend>rclcpp</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Gazebo/Sensor dependencies for ground truth (M3) -->
  <depend>gazebo_ros</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>

  <!-- Development dependencies -->
  <exec_depend>ament_cmake_gtest</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
